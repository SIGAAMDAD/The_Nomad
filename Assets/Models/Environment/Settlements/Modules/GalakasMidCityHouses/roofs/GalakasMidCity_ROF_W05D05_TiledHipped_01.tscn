use_collision = true
metadata/roof_type = "tiled_hipped_v10_same_rotation_cutout_slabs"
metadata/size_code = "W05D05"
metadata/construction = "Roof tile slabs are flat CSGBox3D panels with broad X/Z faces and thin Y thickness. Subtractive CSGBox3D cutters use operation = 2 and have exactly the same rotation as the roof tile slab they trim. Cutters are thin slabs placed just above/intersecting the roof plane, then offset along the plane to shave excess. No random yawed cutters. No triangular CSG primitives."
metadata/material_policy = "No materials assigned. CSG node names specify intended material target: Mat_RoofTile, Mat_WoodBeam, Mat_Metal, etc."
metadata/cutout_policy = "Every Cutout_* node has the same Euler rotation as its target Mat_RoofTile_CSGBox_* node. The only differences are size and position. This matches the prototype workflow where roof boxes are trimmed by boxes sitting directly over the roof plane."

