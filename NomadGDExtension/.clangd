CompileFlags:
  CompilationDatabase: .

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None

  ClangTidy:
    FastCheckFilter: Loose

Completion:
  AllScopes: Yes
  ArgumentLists: FullPlaceholders
  HeaderInsertion: IWYU
  CodePatterns: All
  MacroFilter: ExactPrefix

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
  Designators: true
  BlockEnd: false
  DefaultArguments: false
  TypeNameLimit: 32

Hover:
  ShowAKA: true
