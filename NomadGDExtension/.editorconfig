# idTech 4 / Doom 3-style C/C++ formatting
#
# Naming, const-correctness, function overloading policy, file naming, and the
# historical "( void )" convention cannot be enforced by EditorConfig alone.

root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,inl,ipp}]

# -----------------------------------------------------------------------------
# Indentation
#
# Real tabs, displayed as 4 columns.
# -----------------------------------------------------------------------------

indent_style = tab
indent_size = 4
tab_width = 4

cpp_indent_braces = false
cpp_indent_multi_line_relative_to = statement_begin
cpp_indent_within_parentheses = align_to_parenthesis
cpp_indent_preserve_within_parentheses = true

cpp_indent_case_contents = true
cpp_indent_case_labels = true
cpp_indent_case_contents_when_block = true

cpp_indent_goto_labels = one_left
cpp_indent_preprocessor = leftmost_column

# public:, protected:, private: remain flush with the type body.
cpp_indent_access_specifiers = false

cpp_indent_namespace_contents = true
cpp_indent_preserve_comments = true

# -----------------------------------------------------------------------------
# Braces / newlines
#
# Types and functions:
#
# class Foo
# {
# };
#
# void Function( void )
# {
# }
#
# Control flow:
#
# if ( condition ) {
# } else {
# }
# -----------------------------------------------------------------------------

cpp_new_line_before_open_brace_namespace = same_line
cpp_new_line_before_open_brace_type = new_line
cpp_new_line_before_open_brace_function = new_line
cpp_new_line_before_open_brace_lambda = new_line

cpp_new_line_before_open_brace_block = same_line

cpp_new_line_before_catch = false
cpp_new_line_before_else = false
cpp_new_line_before_while_in_do_while = false

cpp_wrap_preserve_blocks = one_liners

# -----------------------------------------------------------------------------
# Parentheses
#
# Function( value );
# if ( condition ) {
# x = ( y * 0.5f );
#
# Casts:
#
# (type)value
# -----------------------------------------------------------------------------

cpp_space_before_function_open_parenthesis = remove
cpp_space_within_parameter_list_parentheses = true

cpp_space_between_empty_parameter_list_parentheses = false

cpp_space_after_keywords_in_control_flow_statements = true
cpp_space_within_control_flow_statement_parentheses = true

cpp_space_within_cast_parentheses = false
cpp_space_after_cast_close_parenthesis = false

cpp_space_within_expression_parentheses = true

# -----------------------------------------------------------------------------
# Braces / initializer syntax
# -----------------------------------------------------------------------------

cpp_space_before_block_open_brace = true
cpp_space_between_empty_braces = false

cpp_space_before_initializer_list_open_brace = true
cpp_space_within_initializer_list_braces = true
cpp_space_preserve_in_initializer_list = true

# -----------------------------------------------------------------------------
# Arrays / indexing
#
# values[ i ]
# -----------------------------------------------------------------------------

cpp_space_before_open_square_bracket = false
cpp_space_within_square_brackets = true
cpp_space_before_empty_square_brackets = false
cpp_space_between_empty_square_brackets = false
cpp_space_group_square_brackets = true

cpp_space_within_lambda_brackets = false
cpp_space_between_empty_lambda_brackets = false
cpp_space_before_lambda_open_parenthesis = false

# -----------------------------------------------------------------------------
# Operators / punctuation
# -----------------------------------------------------------------------------

cpp_space_before_comma = false
cpp_space_after_comma = true

cpp_space_remove_around_member_operators = true

cpp_space_before_inheritance_colon = true
cpp_space_before_constructor_colon = true

cpp_space_remove_before_semicolon = true
cpp_space_after_semicolon = true

cpp_space_remove_around_unary_operator = true
cpp_space_around_binary_operator = insert
cpp_space_around_assignment_operator = insert
cpp_space_around_ternary_operator = insert

# const char *name
# idEntity *entity
# const idDict &dict
cpp_space_pointer_reference_alignment = left

# -----------------------------------------------------------------------------
# CMake
# -----------------------------------------------------------------------------

[*.cmake]
indent_style = tab
indent_size = 4
tab_width = 4

[CMakeLists.txt]
indent_style = tab
indent_size = 4
tab_width = 4

# -----------------------------------------------------------------------------
# JSON / YAML
# -----------------------------------------------------------------------------

[*.{json,yml,yaml}]
indent_style = space
indent_size = 4
